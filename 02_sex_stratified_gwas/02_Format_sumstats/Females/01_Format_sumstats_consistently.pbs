awk 'FNR==1 && NR!=1 {next} {print}' rosmap_fastGWA_female.fastGWA rosmap_fastGWA_female_nPAR.fastGWA rosmap_fastGWA_female_PAR.fastGWA > rosmap_females_autosomes_and_X.txt

awk 'BEGIN{OFS="\t"} {if(NR==1) print $0, "INFO", "STUDY"; else print $0, "0.95", "1"}' rosmap_females_autosomes_and_X.txt >rosmap_females_autosomes_and_X_withinfoandstudy.txt

cat rosmap_females_autosomes_and_X_withinfoandstudy.txt | awk 'NR==1 {print $0, "MAF"; next} {maf=$7; if($7>0.5) maf=1-$7; print $0, maf}' > temp.txt && mv temp.txt rosmap_females_autosomes_and_X_withinfoandstudy.txt



