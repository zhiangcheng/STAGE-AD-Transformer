awk 'BEGIN{OFS="\t"} {if(NR==1) print $0, "INFO", "STUDY"; else print $0, "0.95", "1"}' rosmap_males_autosomes_and_X.txt >rosmap_males_autosomes_and_X_withinfoandstudy.txt

