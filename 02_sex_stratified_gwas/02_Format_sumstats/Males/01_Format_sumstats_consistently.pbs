awk 'NR==1 {print "CHR", "BP", "A1", "A2", "FREQA1", "BETA", "SE", "P", "N", "MAF", "STUDY", "INFO"} NR>1 {print $1,$3,$4,$5,$7,$11,$12,$13,$6,$17,$16,$15}' ${rosmap_male} > rosmap_build37_ad_male_sumstats.txt
