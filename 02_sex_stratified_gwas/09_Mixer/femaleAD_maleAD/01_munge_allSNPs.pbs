# Overview [https://github.com/precimed/python_convert]
#!/bin/bash

conda activate mixer
cd /media/desk15/iy2120/Project2026/Myproject_AD/02_sex_stratified_gwas/070_Mixer/femaleAD_maleAD/

***************************************************convert_ad_sumstats_female.sh
#!/bin/bash
set -euo pipefail

INFILE="/media/desk15/iy2120/Project2026/Myproject_AD/02_sex_stratified_gwas/020_Meta_analysis/Females/Metaanalysis_ad_female_AllCohorts_QCed_rsID.txt"
OUTFILE="/media/desk15/iy2120/Project2026/Myproject_AD/02_sex_stratified_gwas/070_Mixer/femaleAD_maleAD/munged_sumstats/Metaanalysis_ad_female_AllCohorts_QCed_rsID.txt"

awk '
BEGIN {
    OFS="\t"
}
NR==1 {
    # Modify the header
    $2="A1"
    $3="A2"
    $NF="SNP"

    # Remove the first column and output from the second column onward
    for (i=2; i<=NF; i++) {
        printf "%s%s", $i, (i<NF ? OFS : ORS)
    }
    next
}
NR>1 {
    # Convert A1/A2 to uppercase
    $2=toupper($2)
    $3=toupper($3)

    # Remove the first column and output from the second column onward
    for (i=2; i<=NF; i++) {
        printf "%s%s", $i, (i<NF ? OFS : ORS)
    }
}
' "$INFILE" > "$OUTFILE"

echo "Done:"
echo "$OUTFILE"

***************************************************convert_ad_sumstats_male.sh
#!/bin/bash
set -euo pipefail

INFILE="/media/desk15/iy2120/Project2026/Myproject_AD/02_sex_stratified_gwas/020_Meta_analysis/Males/Metaanalysis_ad_male_AllCohorts_QCed_rsID.txt"
OUTFILE="/media/desk15/iy2120/Project2026/Myproject_AD/02_sex_stratified_gwas/070_Mixer/femaleAD_maleAD/munged_sumstats/Metaanalysis_ad_male_AllCohorts_QCed_rsID.txt"

awk '
BEGIN {
    OFS="\t"
}
NR==1 {
    # Modify the header
    $2="A1"
    $3="A2"
    $NF="SNP"

    # Remove the first column and output from the second column onward
    for (i=2; i<=NF; i++) {
        printf "%s%s", $i, (i<NF ? OFS : ORS)
    }
    next
}
NR>1 {
    # Convert A1/A2 to uppercase
    $2=toupper($2)
    $3=toupper($3)

    # Remove the first column and output from the second column onward
    for (i=2; i<=NF; i++) {
