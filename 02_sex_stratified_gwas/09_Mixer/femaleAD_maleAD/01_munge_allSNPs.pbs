#female
python /media/desk15/iy2120/Genomic_tools/python_convert/sumstats.py csv \
--sumstats /media/desk15/iy2120/Project2026/Myproject_AD/02_sex_stratified_gwas/070_Mixer/femaleAD_maleAD/munged_sumstats/Metaanalysis_ad_female_AllCohorts_QCed_rsID.txt \
--out ./munged_sumstats/Metaanalysis_ad_female_AllCohorts.csv \
--force --auto \
--head 5 \
--n-val 1279

python /media/desk15/iy2120/Genomic_tools/python_convert/sumstats.py zscore \
    --sumstats ./munged_sumstats/Metaanalysis_ad_female_AllCohorts.csv | \
python /media/desk15/iy2120/Genomic_tools/python_convert/sumstats.py qc \
    --exclude-ranges 6:26000000-34000000 19:44900000-46500000 \
    --out ./munged_sumstats/Metaanalysis_ad_female_AllCohorts_noMHC_APOE.csv \
    --force

gzip ./munged_sumstats/Metaanalysis_ad_female_AllCohorts_noMHC_APOE.csv

#male
python /media/desk15/iy2120/Genomic_tools/python_convert/sumstats.py csv \
--sumstats /media/desk15/iy2120/Project2026/Myproject_AD/02_sex_stratified_gwas/070_Mixer/femaleAD_maleAD/munged_sumstats/Metaanalysis_ad_male_AllCohorts_QCed_rsID.txt \
--out ./munged_sumstats/Metaanalysis_ad_male_AllCohorts.csv \
--force --auto \
