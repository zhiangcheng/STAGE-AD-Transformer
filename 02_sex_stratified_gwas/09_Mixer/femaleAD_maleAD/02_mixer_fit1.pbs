##############################################################################

#!/bin/bash
set -euo pipefail

# Load the environment
source activate mixer

# Configure paths
WORKDIR="/media/desk15/iy2120/Project2026/Myproject_AD/02_sex_stratified_gwas/070_Mixer/femaleAD_maleAD"
MIXER_SIF="/media/desk15/iy2120/Genomic_tools/mixer/mixer.sif"

REFDIR="/media/desk15/iy2120/Genomic_tools/mixer/reference/ldsc/1000G_EUR_Phase3_plink"
SUMSTAT_DIR="${WORKDIR}/munged_sumstats"
OUTDIR="${WORKDIR}/mixer_fit1"

mkdir -p "${OUTDIR}"
cd "${WORKDIR}"

export MIXER_PY="singularity exec \
  --bind /media/desk15/iy2120:/media/desk15/iy2120 \
  ${MIXER_SIF} \
  python3 /tools/mixer/precimed/mixer.py"

# Check array_values.txt
if [ ! -f "array_values.txt" ]; then
    echo "Error: array_values.txt not found in ${WORKDIR}"
    exit 1
fi

# Read array_values.txt line by line
# Format of each line: trait rep
while read -r trait rep; do
    # Skip empty lines
    if [ -z "${trait:-}" ]; then
        continue
    fi

    echo "======================================"
    echo "Running MiXeR fit1"
    echo "Trait: ${trait}"
    echo "Rep:   ${rep}"
    echo "======================================"

    ${MIXER_PY} fit1 \
        --bim-file "${REFDIR}/1000G.EUR.QC.@.bim" \
        --ld-file "${REFDIR}/1000G.EUR.QC.@.run4.ld" \
        --extract "${REFDIR}/1000G.EUR.QC.prune_maf0p05_rand2M_r2p8.rep${rep}.snps" \
        --trait1-file "${SUMSTAT_DIR}/${trait}.csv.gz" \
        --out "${OUTDIR}/${trait}.fit.rep${rep}"

    echo "Finished: ${trait} rep${rep}"
    echo

done < array_values.txt












