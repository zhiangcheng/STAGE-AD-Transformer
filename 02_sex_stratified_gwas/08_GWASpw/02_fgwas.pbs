#!/bin/bash
#PBS -l walltime=01:00:00
#PBS -l mem=10GB
#PBS -l ncpus=1

# This script uses fgwas to calculate a posterior probability of association (ppa) for each SNP and each segment
# Note this is only for autosomes. Need bed file that includes X chromosome to include SNPs on X chromosome


### Environment ###

#module load fgwas/0.3.6


### Preamble ###

directory=/media/desk15/iy2120/Project2026/Myproject_AD/02_sex_stratified_gwas/060_GWASpw/ # working directory

reference=/media/desk15/iy2120/Project2026/Myproject_AD/02_sex_stratified_gwas/060_GWASpw/gwaspw_reference/ # location of reference directory where .bed file is located

input1=female_ad_sumstats_formatted_fgwas_no_chr23_removed_multiallelics.sorted.in_ldblocks.sorted2 # 1st set of sum stats that are formatted for fgwas

input2=male_ad_sumstats_formatted_fgwas_no_chr23_removed_multiallelics.sorted.in_ldblocks.sorted2 # 2nd set of sum stats that are formatted for fgwas

output1=femaleAD # name of fgwas output based on 1st set of sum stats

output2=maleAD # name of fgwas output based on 2nd set of sum stats


### Submit script ###

cd ${directory}

# Run fgwas for first file

/media/desk15/iy2120/Genomic_tools/fgwas/src/fgwas -i ${input1} \
 -bed ${reference}EUR/fourier_ls-all.bed \
 -print \
 -o ${output1}


# Run fgwas for second file

/media/desk15/iy2120/Genomic_tools/fgwas/src/fgwas -i ${input2} \
 -bed ${reference}EUR/fourier_ls-all.bed \
 -print \
 -o ${output2}


# -print: to re-weight GWAS and output posterior probabilities of association
# -cc: when inputting summary statistics for a binary trait (case/control)
# documentation states 'if you include a column labeled SE in the header of the file, this column will be taken as a direct estimate of the standard errors of
# the log-odds ratio and will override the sample size and allele frequency columns'
# However, if only include SE get WARNING: detected SE in header, will override F and N and ERROR: cannot find F in header
# So included F and N to not get this error
# If include -cc flag get ERROR: cannot find NCASE in header (case/control should have NCASE and NCONTROL whereas quatitative just needs N)
# But if run without -cc flag and provide SE, F and N get WARNING: detected SE in header, will override F and N
# So it appears that -cc is just telling fgwas what headers to look for, and as we're using SE instead of F and N (NCASE and NCONTROL) this doesn't matter



# output: a .bfs and a .segbfs for each trait. 
# They will have a posterior probability of association (ppa) for each SNP (.bfs) or each segment (.segbfs). 
# segment PPA = the posterior probability that the segment contains a SNP associated with the trait
# SNP PPA = the posterior probability that the SNP is causal



















```
nohup bash 02_fgwas.sh >02_fgwas.log 2>&1 &
```











****************************************************************************************************prepare_fgwas.sh
source activate GWAS

cd /media/desk15/iy2120/Project2026/Myproject_AD/02_sex_stratified_gwas/060_GWASpw/

set -euo pipefail

bed=gwaspw_reference/EUR/fourier_ls-all.bed
clean_bed=gwaspw_reference/EUR/fourier_ls-all.clean.bed

# 1. Clean the LD-block BED file
awk '
BEGIN{OFS="\t"}
NR==1 && ($1 ~ /chr|CHR|chrom|Chrom/ || $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9]+$/) {next}
{
  chr=$1
  gsub(/^chr/,"",chr)
  if($2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3>$2){
    print chr, $2-1, $3
  }
}
' "$bed" > "$clean_bed"

echo "Clean BED created:"
head "$clean_bed"

# 2. Filter the summary statistics
for input in \
  female_ad_sumstats_formatted_fgwas_no_chr23_removed_multiallelics.sorted \
  male_ad_sumstats_formatted_fgwas_no_chr23_removed_multiallelics.sorted \
  female_male_ad_sumstats_formatted_gwaspw_no_chr23_removed_multiallelics.sorted
do
  output=${input}.in_ldblocks

  header_tmp=$(mktemp)
  body_tmp=$(mktemp)

  awk -v header="$header_tmp" '
  BEGIN{OFS="\t"}
  NR==1 {
    for(i=1;i<=NF;i++){
      if($i=="CHR") c=i
      if($i=="POS") p=i
    }
    if(c=="" || p==""){
      print "ERROR: Cannot find CHR or POS column in header" > "/dev/stderr"
      exit 1
    }
    print > header
    next
  }
  {
    chr=$c
    gsub(/^chr/,"",chr)
    pos=$p
    if(pos ~ /^[0-9]+$/){
      print chr, pos-1, pos, $0
    }
  }
  ' "$input" \
  | bedtools intersect -a - -b "$clean_bed" -wa -u \
  | cut -f4- > "$body_tmp"

  cat "$header_tmp" "$body_tmp" > "$output"

  echo "Created $output"
  echo "Original variants:"
  tail -n +2 "$input" | wc -l
  echo "Variants in LD blocks:"
  tail -n +2 "$output" | wc -l

  rm -f "$header_tmp" "$body_tmp"
done


for input in \
  female_ad_sumstats_formatted_fgwas_no_chr23_removed_multiallelics.sorted.in_ldblocks \
  male_ad_sumstats_formatted_fgwas_no_chr23_removed_multiallelics.sorted.in_ldblocks \
  female_male_ad_sumstats_formatted_gwaspw_no_chr23_removed_multiallelics.sorted.in_ldblocks
do
  output=${input}.sorted2

  awk '
  BEGIN{OFS="\t"}
  NR==1 {
    for(i=1;i<=NF;i++){
      if($i=="CHR") c=i
      if($i=="POS") p=i
    }
    print > "/tmp/fgwas_sort_header.txt"
    next
  }
  {
    chr=$c
    gsub(/^chr/,"",chr)
    print chr, $p, $0
  }
  ' "$input" \
  | sort -k1,1n -k2,2n \
  | cut -f3- > /tmp/fgwas_sort_body.txt

  cat /tmp/fgwas_sort_header.txt /tmp/fgwas_sort_body.txt > "$output"

  echo "Created $output"
done











